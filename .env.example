# Supabase project settings (Project Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-only, bypasses Row Level Security. Never expose
# this to the client or commit it. Used by src/lib/supabase/service.ts to
# write AI chat messages after streaming a response.
SUPABASE_SERVICE_ROLE_KEY=

# Groq API key — powers the AI agent chat feature (src/app/api/chat/route.ts).
GROQ_API_KEY=
